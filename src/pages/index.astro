---
import Sidebar from '../components/Sidebar.astro';
import ReportForm from '../components/ReportForm.astro';
import ReportViewer from '../components/ReportViewer.astro';
import { initialReports, users } from '../data/initialReports';
import DashboardLayout from '../layouts/DashboardLayout.astro';
import astroAnimationUrl from '../content/docs/astro.riv?url';

const serializedReports = JSON.stringify(initialReports).replace(/</g, '\\u003c');
const serializedUsers = JSON.stringify(users).replace(/</g, '\\u003c');
---

<DashboardLayout title="Reports Hub | Astro">
  <section class="panel login-panel" id="login-panel">
    <div class="login-copy">
      <div class="login-copy-header">
        <p class="topbar-label">PHPEITOR · REPORTES</p>
        <h1>Datos listos para despegar</h1>
      </div>

      <div class="login-rive-frame">
        <canvas id="login-rive" data-rive-src={astroAnimationUrl} aria-label="Astronauta interactivo"></canvas>
        <p class="login-rive-status" id="login-rive-status">
          <span class="login-rive-status__dot"></span>
          <span class="login-rive-status__text">Sistema preparado</span>
        </p>
      </div>
    </div>

    <form id="login-form" class="login-form" novalidate>
      <header class="login-form-header">
        <span>Acceso seguro</span>
        <h2>Bienvenido</h2>
        <p>Ingresa con tu usuario y perfil asignado.</p>
      </header>

      <label class="field">
        <span>Usuario</span>
        <input id="login-user" name="user" type="text" placeholder="administrador" autocomplete="username" required />
      </label>

      <label class="field">
        <span>Rol</span>
        <select id="login-role" name="role" required>
          <option value="admin">Admin</option>
          <option value="operaciones">Operaciones</option>
          <option value="finanzas">Finanzas</option>
          <option value="comercial">Comercial</option>
        </select>
      </label>

      <button class="primary-btn" type="submit">Entrar</button>
      <a class="docs-login-link" href="/docs/">Explorar documentación</a>
      <p class="form-message" id="login-message" role="status" aria-live="polite"></p>
    </form>
  </section>

  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <div class="dashboard-shell is-hidden" id="app-root">
    <Sidebar />

    <main class="content-area">
      <header class="topbar">
        <div>
          <div class="workspace-status"><span></span> Workspace operativo</div>
          <h2>Visor de Reportes</h2>
          <p class="session-note" id="session-note">Sesión inactiva</p>
        </div>

        <div class="topbar-actions">
          <button class="ghost-btn theme-toggle" type="button" id="theme-toggle" aria-label="Activar tema oscuro" title="Cambiar tema">
            <svg class="theme-icon theme-icon--sun" aria-hidden="true" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="3.5"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
            </svg>
            <svg class="theme-icon theme-icon--moon" aria-hidden="true" viewBox="0 0 24 24">
              <path d="M20.2 15.2A8.5 8.5 0 0 1 8.8 3.8 8.5 8.5 0 1 0 20.2 15.2Z"></path>
            </svg>
            <span class="sr-only">Cambiar tema</span>
          </button>
          <button class="ghost-btn ghost-danger" type="button" id="logout-btn">Salir</button>
        </div>
      </header>

      <section class="content-grid" id="workspace-grid">
        <div class="admin-form-wrap" id="admin-form-wrap">
          <ReportForm />
        </div>

        <ReportViewer />
      </section>

      <section class="panel admin-table-panel" id="admin-table-panel" aria-labelledby="table-title">
        <div class="panel-head">
          <h2 id="table-title">Reportes registrados</h2>
          <p>Administra la disponibilidad de cada reporte.</p>
        </div>

        <div class="table-shell">
          <table class="reports-table">
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Modulo</th>
                <th>Plataforma</th>
                <th>Estado</th>
                <th>URL</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="reports-table-body"></tbody>
          </table>
        </div>

        <div class="table-pagination" id="table-pagination"></div>
      </section>
    </main>
  </div>

  <script type="module" define:vars={{ serializedReports, serializedUsers }}>
    /** @typedef {'admin' | 'operaciones' | 'finanzas' | 'comercial'} AppRole */
    /** @typedef {'powerbi' | 'tableau' | 'superset' | 'qlik' | 'grafana' | 'looker' | 'other'} BiPlatform */
    /** @typedef {'iframe-public' | 'external-link' | 'official-sdk' | 'secure-token'} EmbedStrategy */

    /** @typedef {{
     * id: string;
     * name: string;
     * module: string;
     * url: string;
     * platform: BiPlatform;
     * strategy: EmbedStrategy;
      * status: 0 | 1;
     * }} ReportItem
     */

    /** @typedef {{ user: string; role: AppRole }} SessionState */

    /** @typedef {{ user: string; role: AppRole; displayName?: string }} UserItem */

    const REPORTS_KEY = 'bi-reports-v2';
    const AUTH_KEY = 'bi-auth-v1';
    const THEME_KEY = 'bi-theme-v1';

    /** @type {ReportItem[]} */
    const initialReportsState = JSON.parse(serializedReports);
    /** @type {UserItem[]} */
    const userList = JSON.parse(serializedUsers);

    /** @type {ReportItem[]} */
    let reports = loadReports();
    /** @type {SessionState | null} */
    let session = loadSession();
    let selectedReportId = '';
    let selectedModule = '';
    let currentPage = 1;
    let editingReportId = '';
    const PAGE_SIZE = 5;

    const loginPanel = document.querySelector('#login-panel');
    const loginForm = document.querySelector('#login-form');
    const loginMessage = document.querySelector('#login-message');
    const toast = document.querySelector('#toast');
    const appRoot = document.querySelector('#app-root');
    const sessionNote = document.querySelector('#session-note');
    const sidebarSession = document.querySelector('#sidebar-session');
    const sidebarModules = document.querySelector('#sidebar-modules');
    const reportForm = document.querySelector('#report-form');
    const reportMeta = document.querySelector('#report-meta');
    const platformChip = document.querySelector('#platform-chip');
    const reportFrame = document.querySelector('#report-frame');
    const externalReport = document.querySelector('#external-report');
    const externalReportTitle = document.querySelector('#external-report-title');
    const externalReportLink = document.querySelector('#external-report-link');
    const formMessage = document.querySelector('#form-message');
    const reportsTableBody = document.querySelector('#reports-table-body');
    const tablePagination = document.querySelector('#table-pagination');
    const adminFormWrap = document.querySelector('#admin-form-wrap');
    const adminTablePanel = document.querySelector('#admin-table-panel');
    const workspaceGrid = document.querySelector('#workspace-grid');
    const themeToggle = document.querySelector('#theme-toggle');
    const logoutBtn = document.querySelector('#logout-btn');
    const sidebarToggle = document.querySelector('#sidebar-toggle');

    const roleLabels = {
      admin: 'Admin',
      operaciones: 'Operaciones',
      finanzas: 'Finanzas',
      comercial: 'Comercial'
    };

    const roleModules = {
      admin: null,
      operaciones: 'Operaciones',
      finanzas: 'Finanzas',
      comercial: 'Comercial'
    };

    applyThemeFromStorage();

    function loadReports() {
      const normalize = (items) =>
        items.map((item) => ({
          ...item,
          status: item.status === 0 ? 0 : 1
        }));

      try {
        const saved = localStorage.getItem(REPORTS_KEY);
        if (!saved) {
          return normalize([...initialReportsState]);
        }

        const parsed = JSON.parse(saved);
        return Array.isArray(parsed) ? normalize(parsed) : normalize([...initialReportsState]);
      } catch {
        return normalize([...initialReportsState]);
      }
    }

    /** @returns {SessionState | null} */
    function loadSession() {
      try {
        const saved = localStorage.getItem(AUTH_KEY);
        if (!saved) {
          return null;
        }

        const parsed = JSON.parse(saved);
        if (!parsed || typeof parsed.user !== 'string' || typeof parsed.role !== 'string') {
          return null;
        }

        return /** @type {SessionState} */ (parsed);
      } catch {
        return null;
      }
    }

    function applyThemeFromStorage() {
      const savedTheme = localStorage.getItem(THEME_KEY);
      if (savedTheme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    }

    function saveReports() {
      localStorage.setItem(REPORTS_KEY, JSON.stringify(reports));
    }

    /** @param {string} user */
    function findUser(user) {
      return userList.find((item) => item.user.toLowerCase() === user.toLowerCase()) ?? null;
    }

    let toastTimer;

    function showToast(message, tone = 'error') {
      if (!toast) {
        return;
      }

      toast.textContent = message;
      toast.dataset.state = tone;
      toast.classList.add('is-visible');

      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.classList.remove('is-visible');
      }, 2800);
    }

    /** @param {SessionState | null} nextSession */
    function saveSession(nextSession) {
      if (!nextSession) {
        localStorage.removeItem(AUTH_KEY);
        return;
      }

      localStorage.setItem(AUTH_KEY, JSON.stringify(nextSession));
    }

    const uniqueId = () => {
      if (window.crypto?.randomUUID) {
        return window.crypto.randomUUID();
      }

      return `report-${Date.now()}-${Math.floor(Math.random() * 99999)}`;
    };

    /** @param {string} value */
    function shortLabel(value) {
      return value
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((word) => word[0]?.toUpperCase() ?? '')
        .join('');
    }

    /** @param {string} value */
    function escapeHtml(value) {
      return value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    /** @param {string} url */
    function detectPlatform(url) {
      const lowered = url.toLowerCase();

      if (lowered.includes('powerbi') || lowered.includes('fabric.microsoft.com')) {
        return 'powerbi';
      }

      if (lowered.includes('tableau')) {
        return 'tableau';
      }

      if (lowered.includes('superset')) {
        return 'superset';
      }

      if (lowered.includes('qlik')) {
        return 'qlik';
      }

      if (lowered.includes('grafana')) {
        return 'grafana';
      }

      if (lowered.includes('lookerstudio') || lowered.includes('datastudio')) {
        return 'looker';
      }

      return 'other';
    }

    /** @param {string} url */
    function resolveStrategy(url) {
      const lowered = url.toLowerCase();
      const platform = detectPlatform(url);

      if (platform === 'powerbi') {
        if (lowered.includes('fabric.microsoft.com/view?r=')) {
          return 'iframe-public';
        }

        if (lowered.includes('reportembed')) {
          return 'secure-token';
        }

        return 'official-sdk';
      }

      if (platform === 'tableau') {
        if (lowered.includes('public.tableau.com')) {
          return 'iframe-public';
        }

        return 'official-sdk';
      }

      if (platform === 'superset' || platform === 'qlik' || platform === 'grafana') {
        return 'external-link';
      }

      return 'iframe-public';
    }

    /** @param {string} url */
    function normalizeUrl(url) {
      const platform = detectPlatform(url);

      if (platform !== 'tableau') {
        return url;
      }

      try {
        const parsed = new URL(url);
        if (!parsed.searchParams.has(':showVizHome')) {
          parsed.searchParams.set(':showVizHome', 'no');
        }

        return parsed.toString();
      } catch {
        return url;
      }
    }

    /** @param {AppRole} role */
    function getRoleModule(role) {
      return roleModules[role];
    }

    /** @param {AppRole} role */
    function getVisibleReports(role = session?.role ?? 'admin') {
      const activeReports = reports.filter((report) => report.status === 1);

      if (role === 'admin') {
        return [...activeReports];
      }

      const moduleName = getRoleModule(role);
      return activeReports.filter((report) => report.module === moduleName);
    }

    function ensureSelection() {
      const visibleReports = getVisibleReports();

      if (!visibleReports.length) {
        selectedReportId = '';
        selectedModule = session?.role ? (getRoleModule(session.role) ?? '') : '';
        return;
      }

      const selectedReport = visibleReports.find((report) => report.id === selectedReportId);
      if (selectedReport) {
        selectedModule = selectedReport.module;
        return;
      }

      selectedReportId = visibleReports[0].id;
      selectedModule = visibleReports[0].module;
    }

    function updateSessionLabels() {
      if (!session) {
        return;
      }

      const label = `${session.user} | ${roleLabels[session.role]}`;
      if (sessionNote) {
        sessionNote.textContent = label;
      }

      if (sidebarSession) {
        sidebarSession.textContent = label;
      }
    }

    function renderAdminState() {
      if (!adminFormWrap || !adminTablePanel || !workspaceGrid || !reportForm) {
        return;
      }

      const isAdmin = session?.role === 'admin';
      adminFormWrap.hidden = !isAdmin;
      adminTablePanel.hidden = !isAdmin;
      reportForm.hidden = !isAdmin;
      workspaceGrid.classList.toggle('single-view', !isAdmin);
    }

    function renderLoginState() {
      const loggedIn = Boolean(session);
      if (loginPanel) {
        loginPanel.hidden = loggedIn;
      }

      if (appRoot) {
        appRoot.classList.toggle('is-hidden', !loggedIn);
      }

      if (loggedIn) {
        updateSessionLabels();
      }
    }

    function renderSidebar() {
      if (!sidebarModules) {
        return;
      }

      if (!session) {
        sidebarModules.innerHTML = '';
        return;
      }

      const visibleReports = getVisibleReports();

      const grouped = visibleReports.reduce((acc, report) => {
        if (!acc[report.module]) {
          acc[report.module] = [];
        }

        acc[report.module].push(report);
        return acc;
      }, /** @type {Record<string, ReportItem[]>} */ ({}));

      sidebarModules.innerHTML = Object.entries(grouped)
        .sort(([a], [b]) => a.localeCompare(b, 'es'))
        .map(([moduleName, moduleReports], index) => {
          const open = moduleName === selectedModule || (index === 0 && !selectedModule) ? 'open' : '';
          const moduleLabel = escapeHtml(moduleName);
          const moduleBadge = escapeHtml(shortLabel(moduleName));

          const reportsHtml = moduleReports
            .map((report) => {
              const selectedClass = report.id === selectedReportId ? 'active' : '';
              const reportLabel = escapeHtml(report.name);
              const reportId = escapeHtml(report.id);
              const reportBadge = escapeHtml(shortLabel(report.name));

              return `<li><button class="report-link has-tooltip ${selectedClass}" data-report-id="${reportId}" type="button" data-tooltip="${reportLabel}" aria-label="${reportLabel}"><span class="report-dot" aria-hidden="true">${reportBadge}</span><span class="report-label">${reportLabel}</span></button></li>`;
            })
            .join('');

          return `
            <details class="module-group" ${open} data-module-group="${moduleLabel}">
              <summary class="module-summary has-tooltip" data-tooltip="${moduleLabel}"><span class="module-badge" aria-hidden="true">${moduleBadge}</span><span class="module-label">${moduleLabel}</span></summary>
              <ul class="module-list">${reportsHtml}</ul>
            </details>
          `;
        })
        .join('');

      bindSidebarActions();
    }

    function renderTable() {
      if (!reportsTableBody || !tablePagination) {
        return;
      }

      if (session?.role !== 'admin') {
        reportsTableBody.innerHTML = '';
        tablePagination.innerHTML = '';
        return;
      }

      const tableRows = reports;
      const totalRows = tableRows.length;
      const totalPages = Math.max(1, Math.ceil(totalRows / PAGE_SIZE));
      if (currentPage > totalPages) {
        currentPage = totalPages;
      }

      const start = (currentPage - 1) * PAGE_SIZE;
      const pageRows = tableRows.slice(start, start + PAGE_SIZE);

      if (!totalRows) {
        reportsTableBody.innerHTML = '<tr><td colspan="6">No hay reportes registrados.</td></tr>';
        tablePagination.innerHTML = '';
        return;
      }

      reportsTableBody.innerHTML = pageRows
        .map((report) => {
          const isEditing = editingReportId === report.id;
          const reportName = escapeHtml(report.name);
          const moduleName = escapeHtml(report.module);
          const platform = escapeHtml(report.platform);
          const statusValue = report.status === 1 ? '1' : '0';
          const statusLabel = report.status === 1 ? 'Activo' : 'Inactivo';
          const url = escapeHtml(report.url);

          if (isEditing) {
            return `
              <tr>
                <td><input class="table-input" data-edit-field="name" data-edit-id="${report.id}" value="${reportName}" /></td>
                <td>
                  <select class="table-input" data-edit-field="module" data-edit-id="${report.id}">
                    <option value="Operaciones" ${report.module === 'Operaciones' ? 'selected' : ''}>Operaciones</option>
                    <option value="Finanzas" ${report.module === 'Finanzas' ? 'selected' : ''}>Finanzas</option>
                    <option value="Comercial" ${report.module === 'Comercial' ? 'selected' : ''}>Comercial</option>
                  </select>
                </td>
                <td>
                  <select class="table-input" data-edit-field="platform" data-edit-id="${report.id}">
                    <option value="powerbi" ${report.platform === 'powerbi' ? 'selected' : ''}>Power BI</option>
                    <option value="tableau" ${report.platform === 'tableau' ? 'selected' : ''}>Tableau</option>
                    <option value="superset" ${report.platform === 'superset' ? 'selected' : ''}>Apache Superset</option>
                    <option value="qlik" ${report.platform === 'qlik' ? 'selected' : ''}>Qlik Sense</option>
                    <option value="grafana" ${report.platform === 'grafana' ? 'selected' : ''}>Grafana</option>
                    <option value="looker" ${report.platform === 'looker' ? 'selected' : ''}>Looker Studio</option>
                    <option value="other" ${report.platform === 'other' ? 'selected' : ''}>Otra</option>
                  </select>
                </td>
                <td>
                  <select class="table-input" data-edit-field="status" data-edit-id="${report.id}">
                    <option value="1" ${report.status === 1 ? 'selected' : ''}>Activo</option>
                    <option value="0" ${report.status === 0 ? 'selected' : ''}>Inactivo</option>
                  </select>
                </td>
                <td><input class="table-input" data-edit-field="url" data-edit-id="${report.id}" value="${url}" /></td>
                <td class="actions-cell">
                  <button class="mini-btn" data-action="save" data-id="${report.id}" type="button">Guardar</button>
                  <button class="mini-btn ghost" data-action="cancel" data-id="${report.id}" type="button">Cancelar</button>
                </td>
              </tr>
            `;
          }

          return `
            <tr>
              <td>${reportName}</td>
              <td>${moduleName}</td>
              <td>${escapeHtml(platform.toUpperCase())}</td>
              <td><span class="status-pill" data-state="${statusValue}">${statusLabel}</span></td>
              <td><a href="${url}" target="_blank" rel="noreferrer">Abrir</a></td>
              <td class="actions-cell">
                <button class="mini-btn" data-action="edit" data-id="${report.id}" type="button">Editar</button>
                <button class="mini-btn ${report.status === 1 ? 'danger' : 'success'}" data-action="toggle-status" data-id="${report.id}" type="button">
                  ${report.status === 1 ? 'Desactivar' : 'Activar'}
                </button>
              </td>
            </tr>
          `;
        })
        .join('');

      const from = start + 1;
      const to = Math.min(start + PAGE_SIZE, totalRows);

      tablePagination.innerHTML = `
        <span class="page-info">Mostrando ${from}-${to} de ${totalRows}</span>
        <div class="page-actions">
          <button class="ghost-btn mini-nav" data-page="prev" type="button" ${currentPage === 1 ? 'disabled' : ''}>Anterior</button>
          <span class="page-count">Pagina ${currentPage} / ${totalPages}</span>
          <button class="ghost-btn mini-nav" data-page="next" type="button" ${currentPage === totalPages ? 'disabled' : ''}>Siguiente</button>
        </div>
      `;

      bindTableActions();
    }

    function bindTableActions() {
      if (!reportsTableBody || !tablePagination) {
        return;
      }

      reportsTableBody.querySelectorAll('[data-action="edit"]').forEach((button) => {
        button.addEventListener('click', () => {
          const reportId = button.getAttribute('data-id');
          if (!reportId) {
            return;
          }

          editingReportId = reportId;
          renderTable();
        });
      });

      reportsTableBody.querySelectorAll('[data-action="cancel"]').forEach((button) => {
        button.addEventListener('click', () => {
          editingReportId = '';
          renderTable();
        });
      });

      reportsTableBody.querySelectorAll('[data-action="toggle-status"]').forEach((button) => {
        button.addEventListener('click', () => {
          const reportId = button.getAttribute('data-id');
          if (!reportId) {
            return;
          }

          reports = reports.map((item) => {
            if (item.id !== reportId) {
              return item;
            }

            return {
              ...item,
              status: item.status === 1 ? 0 : 1
            };
          });

          const updatedReport = reports.find((item) => item.id === reportId);
          if (selectedReportId === reportId && updatedReport?.status === 0) {
            selectedReportId = '';
          }

          editingReportId = '';
          saveReports();
          ensureSelection();
          renderSidebar();
          renderTable();
          updateViewer();
          showToast(updatedReport?.status === 1 ? 'Reporte activado.' : 'Reporte desactivado.', 'success');
        });
      });

      reportsTableBody.querySelectorAll('[data-action="save"]').forEach((button) => {
        button.addEventListener('click', () => {
          const reportId = button.getAttribute('data-id');
          if (!reportId) {
            return;
          }

          const nameInput = reportsTableBody.querySelector(`[data-edit-field="name"][data-edit-id="${reportId}"]`);
          const moduleInput = reportsTableBody.querySelector(`[data-edit-field="module"][data-edit-id="${reportId}"]`);
          const platformInput = reportsTableBody.querySelector(`[data-edit-field="platform"][data-edit-id="${reportId}"]`);
          const statusInput = reportsTableBody.querySelector(`[data-edit-field="status"][data-edit-id="${reportId}"]`);
          const urlInput = reportsTableBody.querySelector(`[data-edit-field="url"][data-edit-id="${reportId}"]`);

          const name = String(nameInput?.value ?? '').trim();
          const module = String(moduleInput?.value ?? '').trim();
          const platform = String(platformInput?.value ?? 'other');
          const status = Number(statusInput?.value ?? 1) === 1 ? 1 : 0;
          const url = String(urlInput?.value ?? '').trim();

          if (!name || !module || !url) {
            showToast('Completa los datos antes de guardar.', 'error');
            return;
          }

          try {
            new URL(url);
          } catch {
            showToast('La URL editada no es valida.', 'error');
            return;
          }

          reports = reports.map((item) => {
            if (item.id !== reportId) {
              return item;
            }

            return {
              ...item,
              name,
              module,
              url,
              platform: /** @type {BiPlatform} */ (platform),
              status,
              strategy: resolveStrategy(url)
            };
          });

          editingReportId = '';
          saveReports();
          ensureSelection();
          renderSidebar();
          renderTable();
          updateViewer();
          showToast('Reporte actualizado.', 'success');
        });
      });

      tablePagination.querySelectorAll('[data-page]').forEach((button) => {
        button.addEventListener('click', () => {
          const action = button.getAttribute('data-page');
          const totalPages = Math.max(1, Math.ceil(reports.length / PAGE_SIZE));

          if (action === 'prev' && currentPage > 1) {
            currentPage -= 1;
          }

          if (action === 'next' && currentPage < totalPages) {
            currentPage += 1;
          }

          editingReportId = '';
          renderTable();
        });
      });
    }

    function updateViewer() {
      if (!reportMeta || !platformChip || !reportFrame || !externalReport || !externalReportTitle || !externalReportLink) {
        return;
      }

      const visibleReports = getVisibleReports();
      const selected = visibleReports.find((report) => report.id === selectedReportId) ?? visibleReports[0];

      if (!selected) {
        reportMeta.textContent = 'No hay reportes disponibles para este rol.';
        platformChip.textContent = 'Sin datos';
        reportFrame.removeAttribute('src');
        reportFrame.hidden = false;
        externalReport.hidden = true;
        return;
      }

      selectedReportId = selected.id;
      selectedModule = selected.module;
      reportMeta.textContent = `${selected.module} | ${selected.name}`;
      platformChip.textContent = `${selected.platform.toUpperCase()} | ${selected.strategy}`;
      const opensExternally = selected.strategy === 'external-link';
      reportFrame.hidden = opensExternally;
      externalReport.hidden = !opensExternally;

      if (opensExternally) {
        reportFrame.removeAttribute('src');
        externalReportTitle.textContent = selected.name;
        externalReportLink.setAttribute('href', selected.url);
      } else {
        reportFrame.src = normalizeUrl(selected.url);
        externalReportLink.removeAttribute('href');
      }

      document.querySelectorAll('.report-link').forEach((link) => {
        link.classList.toggle('active', link.getAttribute('data-report-id') === selected.id);
      });

      document.querySelectorAll('.module-group').forEach((details) => {
        details.open = details.getAttribute('data-module-group') === selected.module;
      });
    }

    function bindSidebarActions() {
      document.querySelectorAll('.report-link').forEach((button) => {
        button.addEventListener('click', () => {
          const reportId = button.getAttribute('data-report-id');
          if (!reportId) {
            return;
          }

          const report = getVisibleReports().find((item) => item.id === reportId);
          if (!report) {
            return;
          }

          selectedReportId = report.id;
          selectedModule = report.module;
          renderSidebar();
          renderTable();
          updateViewer();
        });
      });
    }

    function setMessage(message, isError = false) {
      if (!formMessage) {
        return;
      }

      formMessage.textContent = message;
      formMessage.dataset.state = isError ? 'error' : 'ok';
    }

    loginForm?.addEventListener('submit', (event) => {
      event.preventDefault();

      const formData = new FormData(loginForm);
      const user = String(formData.get('user') ?? '').trim();
      const role = String(formData.get('role') ?? 'admin');

      if (!user) {
        if (loginMessage) {
          loginMessage.textContent = 'Ingrese un usuario valido';
          loginMessage.dataset.state = 'error';
        }

        showToast('Ingrese un usuario válido', 'error');
        return;
      }

      const matchedUser = findUser(user);
      if (!matchedUser) {
        if (loginMessage) {
          loginMessage.textContent = 'El usuario no existe en la lista permitida';
          loginMessage.dataset.state = 'error';
        }

        showToast('El usuario no existe en la lista permitida', 'error');

        return;
      }

      if (matchedUser.role !== role) {
        if (loginMessage) {
          loginMessage.textContent = 'El rol no coincide con el usuario seleccionado';
          loginMessage.dataset.state = 'error';
        }

        showToast('El rol no coincide con el usuario seleccionado', 'error');

        return;
      }

      session = {
        user: matchedUser.user,
        role: /** @type {AppRole} */ (matchedUser.role)
      };

      saveSession(session);
      ensureSelection();
      renderLoginState();
      renderAdminState();
      updateSessionLabels();
      renderSidebar();
      renderTable();
      updateViewer();
      showToast(`Bienvenido, ${matchedUser.displayName ?? matchedUser.user}.`, 'success');
    });

    logoutBtn?.addEventListener('click', () => {
      session = null;
      saveSession(null);
      selectedReportId = '';
      selectedModule = '';
      renderLoginState();
      renderAdminState();
      renderSidebar();
      renderTable();
      updateViewer();
      if (loginForm) {
        loginForm.reset();
      }
    });

    const compactWorkspace = window.matchMedia('(max-width: 1024px)');
    const updateSidebarToggle = () => {
      const collapsed = appRoot?.classList.contains('sidebar-collapsed') ?? false;
      sidebarToggle?.setAttribute('aria-expanded', String(!collapsed));
      sidebarToggle?.setAttribute('aria-label', collapsed ? 'Expandir sidebar' : 'Colapsar sidebar');
    };
    /** @param {boolean} matches */
    const syncCompactWorkspace = (matches) => {
      appRoot?.classList.toggle('sidebar-collapsed', matches);
      updateSidebarToggle();
    };
    syncCompactWorkspace(compactWorkspace.matches);
    compactWorkspace.addEventListener('change', (event) => syncCompactWorkspace(event.matches));

    sidebarToggle?.addEventListener('click', () => {
      appRoot?.classList.toggle('sidebar-collapsed');
      updateSidebarToggle();
    });

    themeToggle?.addEventListener('click', () => {
      const nextTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', nextTheme);
      localStorage.setItem(THEME_KEY, nextTheme);
      themeToggle.setAttribute('aria-label', nextTheme === 'dark' ? 'Activar tema claro' : 'Activar tema oscuro');
    });

    reportForm?.addEventListener('submit', (event) => {
      event.preventDefault();

      if (session?.role !== 'admin') {
        setMessage('Solo admin puede registrar reportes.', true);
        return;
      }

      const formData = new FormData(reportForm);
      const name = String(formData.get('name') ?? '').trim();
      const module = String(formData.get('module') ?? '').trim();
      const url = String(formData.get('url') ?? '').trim();
      const platformInput = String(formData.get('platform') ?? 'auto');

      if (!name || !module || !url) {
        setMessage('Completa todos los campos obligatorios.', true);
        return;
      }

      try {
        new URL(url);
      } catch {
        setMessage('La URL del reporte no es valida.', true);
        return;
      }

      const autoPlatform = detectPlatform(url);
      const finalPlatform = platformInput === 'auto' ? autoPlatform : platformInput;

      /** @type {ReportItem} */
      const newReport = {
        id: uniqueId(),
        name,
        module,
        url,
        platform: /** @type {BiPlatform} */ (finalPlatform),
        strategy: resolveStrategy(url),
        status: 1
      };

      reports.push(newReport);
      saveReports();
      currentPage = Math.max(1, Math.ceil(reports.length / PAGE_SIZE));
      selectedReportId = newReport.id;
      selectedModule = newReport.module;
      renderSidebar();
      renderTable();
      updateViewer();
      reportForm.reset();
      setMessage('Reporte registrado correctamente.');
    });

    ensureSelection();
    renderLoginState();
    renderAdminState();
    if (session) {
      renderSidebar();
      renderTable();
      updateViewer();
    }
  </script>

  <script>
    import {
      Alignment,
      EventType,
      Fit,
      Layout,
      Rive,
      type StateMachineInput
    } from '@rive-app/canvas';

    const canvas = document.querySelector('#login-rive');
    const status = document.querySelector('#login-rive-status');
    const loginPanel = document.querySelector('#login-panel');
    const loginUser = document.querySelector('#login-user');
    const loginRole = document.querySelector('#login-role');
    const loginButton = document.querySelector('#login-form .primary-btn');
    const docsLink = document.querySelector('.docs-login-link');
    const statusText = document.querySelector('.login-rive-status__text');

    const setStatus = (message: string) => {
      if (statusText) statusText.textContent = message;
    };

    if (canvas instanceof HTMLCanvasElement) {
      const rive = new Rive({
        src: canvas.dataset.riveSrc,
        canvas,
        artboard: 'Astronaut',
        stateMachines: 'State Machine',
        autoplay: true,
        layout: new Layout({ fit: Fit.Contain, alignment: Alignment.Center }),
        onLoad: () => {
          rive.resizeDrawingSurfaceToCanvas();
          const inputs = new Map<string, StateMachineInput>(
            (rive.stateMachineInputs('State Machine') ?? []).map(
              (input): [string, StateMachineInput] => [input.name, input]
            )
          );
          const setInput = (name: string, value: boolean) => {
            const input = inputs.get(name);
            if (input) input.value = value;
          };
          const bindHover = (element: Element | null, inputName: string) => {
            element?.addEventListener('pointerenter', () => setInput(inputName, true));
            element?.addEventListener('pointerleave', () => setInput(inputName, false));
          };
          const bindFocus = (element: Element | null, inputName: string) => {
            element?.addEventListener('focus', () => setInput(inputName, true));
            element?.addEventListener('blur', () => setInput(inputName, false));
          };

          setInput('lightToggle', document.documentElement.dataset.theme !== 'dark');
          bindHover(canvas, 'orbHovering');
          bindFocus(loginUser, 'isLaptopHovered');
          bindFocus(loginRole, 'paperHovered');
          bindHover(loginButton, 'isTimelineHovered');
          bindHover(docsLink, 'pencilHovered');

          new MutationObserver(() => {
            setInput('lightToggle', document.documentElement.dataset.theme !== 'dark');
          }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

          new ResizeObserver(() => rive.resizeDrawingSurfaceToCanvas()).observe(canvas);
        }
      });

      rive.on(EventType.RiveEvent, (event) => {
        const data = event.data;
        const name = data && typeof data === 'object' && 'name' in data ? String(data.name) : '';
        if (!name || !status) return;
        setStatus(name.replace(/([A-Z])/g, ' $1').trim());
      });

      const message = document.querySelector('#login-message');
      if (message instanceof HTMLElement) {
        new MutationObserver(() => {
          if (!message.textContent || !status) return;
          setStatus(message.dataset.state === 'error' ? 'Verifica tus credenciales' : 'Acceso autorizado');
        }).observe(message, { childList: true, attributes: true });
      }

      if (loginPanel) {
        new MutationObserver(() => {
          if (loginPanel.hasAttribute('hidden')) rive.pause();
          else rive.play();
        }).observe(loginPanel, { attributes: true, attributeFilter: ['hidden'] });
      }
    }
  </script>
</DashboardLayout>
