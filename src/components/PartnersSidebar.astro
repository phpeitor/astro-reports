---
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';

const partners = [
  'Dataset',
  'Metadatape',
  'Apache',
  'Superset',
  'PHPeitor',
  'Astro',
  'Laravel',
  'API Platform'
];
---

<div class="lg:sl-hidden">
  <MobileTableOfContents />
</div>

<aside class="partners-panel sl-hidden lg:sl-block" aria-labelledby="partners-title">
  <h2 id="partners-title"><span>//</span> Partners</h2>
  <div class="partners-list">
    {partners.map((partner) => <div class="partner-card">{partner}</div>)}
  </div>
</aside>

<style>
  .partners-panel {
    width: 100%;
    padding: 1.5rem var(--sl-sidebar-pad-x) 2rem;
  }
  .partners-panel h2 {
    margin: 0 0 1rem;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .partners-panel h2 span { color: #f43f5e; font-size: 1rem; }
  .partners-list { display: grid; gap: .65rem; }
  .partner-card {
    display: grid;
    min-height: 4.6rem;
    place-items: center;
    padding: .75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: .75rem;
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
    font-family: Arial Black, Arial, sans-serif;
    font-size: clamp(.8rem, 1vw, 1.05rem);
    font-style: italic;
    font-weight: 900;
    letter-spacing: -.04em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    box-shadow: inset 0 -2px 0 rgba(244, 63, 94, .16);
  }
  :global([data-theme='light']) .partner-card {
    color: #060c3b;
    background: #f4f1eb;
  }
</style>
