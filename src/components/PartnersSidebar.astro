---
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';

const partners = [
  'Dataset',
  'Metadatape',
  'Apache',
  'Superset',
  'PHPeitor',
  'Astro',
  'Laravel',
  'API Platform'
];
---

<div class="lg:sl-hidden">
  <MobileTableOfContents />
</div>

<aside class="partners-panel sl-hidden lg:sl-block" aria-labelledby="partners-title">
  <h2 id="partners-title"><span>//</span> Partners</h2>
  <div class="partners-list">
    {partners.map((partner) => <div class="partner-card">{partner}</div>)}
  </div>
</aside>

<style>
  @property --partner-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  .partners-panel {
    box-sizing: border-box;
    width: calc(
      (100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 * var(--sl-sidebar-pad-x)) * .25
    );
    padding: 1.5rem var(--sl-sidebar-pad-x) 2rem;
  }
  .partners-panel h2 {
    margin: 0 0 1rem;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .partners-panel h2 span { color: #f43f5e; font-size: 1rem; }
  .partners-list { display: grid; gap: .65rem; }
  .partner-card {
    --partner-bg: var(--sl-color-gray-6);
    --partner-border: var(--sl-color-gray-5);
    box-sizing: border-box;
    display: grid;
    width: 100%;
    min-height: 4.6rem;
    place-items: center;
    padding: .75rem;
    border: 2px solid transparent;
    border-radius: .75rem;
    color: #fff !important;
    background:
      linear-gradient(var(--partner-bg), var(--partner-bg)) padding-box,
      conic-gradient(
        from var(--partner-angle),
        var(--partner-border) 0 68%,
        #f43f5e 76%,
        #4052e8 87%,
        #f43f5e 96%,
        var(--partner-border) 100%
      ) border-box;
    font-family: var(--font-display, "Archivo", system-ui, sans-serif);
    font-size: clamp(.8rem, 1vw, 1.05rem);
    font-style: italic;
    font-weight: 900;
    letter-spacing: -.04em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    box-shadow: inset 0 -2px 0 rgba(244, 63, 94, .16);
    animation: partner-border-trace 4.5s linear infinite;
  }
  .partner-card:nth-child(2n) { animation-delay: -2.25s; }
  :global([data-theme='light']) .partner-card {
    --partner-bg: #f4f1eb;
    --partner-border: #c5c7cf;
    color: #060c3b !important;
  }
  @keyframes partner-border-trace {
    to { --partner-angle: 360deg; }
  }
  @media (prefers-reduced-motion: reduce) {
    .partner-card { animation: none; }
  }
</style>
