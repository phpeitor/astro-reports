<section class="panel viewer-panel" aria-labelledby="viewer-title">
  <div class="panel-head viewer-head">
    <div class="viewer-title-wrap">
      <span class="panel-icon viewer-icon" aria-hidden="true">◫</span>
      <div>
        <p class="panel-kicker">Vista activa</p>
        <h2 id="viewer-title">Visor de Reportes</h2>
        <p id="report-meta">Selecciona un reporte para iniciar.</p>
      </div>
    </div>
    <span class="chip" id="platform-chip">Sin seleccionar</span>
  </div>

  <div class="embed-frame-wrap">
    <iframe
      id="report-frame"
      title="Reporte BI embebido"
      loading="lazy"
      referrerpolicy="no-referrer"
      allow="fullscreen"
    ></iframe>
    <div class="external-report" id="external-report" hidden>
      <span class="external-report__icon" aria-hidden="true">↗</span>
      <p class="panel-kicker">Vista externa</p>
      <h3 id="external-report-title">Este reporte se abre en su plataforma</h3>
      <p>El proveedor bloquea la visualización dentro de sitios externos.</p>
      <a id="external-report-link" href="#" target="_blank" rel="noreferrer">Abrir reporte público</a>
    </div>
  </div>
</section>
